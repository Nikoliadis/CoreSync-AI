# CoreSync API — example environment.
#
# Copy to `.env` and fill in. Every value here has a working default in
# `src/coresync/core/config.py`, so a local run needs almost none of it; what is listed
# below is what a deployment actually has to decide.
#
# NOTHING IN THIS FILE BELONGS IN A CLIENT BUILD. Provider credentials stay server-side.

# ------------------------------------------------------------------------ core
ENVIRONMENT=development
DEBUG=false
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=console

# -------------------------------------------------------------------- database
DATABASE_URL=postgresql+asyncpg://coresync:coresync@localhost:5432/coresync
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------ auth
# MUST be replaced in any deployment. The default is a placeholder and is not a secret.
JWT_SECRET_KEY=development-secret-not-for-production-use-only

# The OAuth *client id* is public by design — it appears in the web bundle and identifies
# the app to Google. There is deliberately no client secret: the ID-token flow does not
# use one, which is what keeps a browser client from ever holding a secret at all.
GOOGLE_OAUTH_CLIENT_ID=

# Google issues a separate client id per platform, and the one that requested the token
# is what lands in `aud`. Knowing only the web id refuses every sign-in from a phone.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple needs BOTH, because Apple sets the `aud` claim differently per
# platform and a verifier that knows only one rejects every sign-in from the other.
#
#   APPLE_SERVICE_ID  the Services ID, used by the web flow
#   APPLE_BUNDLE_ID   the iOS app's bundle identifier — currently `ai.coresync.app`
#                     (see mobile/app.json). Native sign-in fails without it.
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=ai.coresync.app

# ------------------------------------------------------------------------- push
# Turns on the Expo push sender in the notification worker. Off by default: an
# unconfigured channel is *skipped* by the dispatcher, which is the right outcome —
# registering a sender that always fails would burn retries against nothing.
PUSH_ENABLED=false

# Optional. Only needed when the Expo project enforces push security. A SERVER
# credential — it must never appear in a mobile build or any client-side config.
EXPO_ACCESS_TOKEN=

# How often the outbox is drained. Notifications are queued transactionally with the
# event that caused them, so this is delivery latency, not reliability.
OUTBOX_DISPATCH_SECONDS=60

# ------------------------------------------------------------------------ email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=CoreSync <no-reply@coresync.ai>

# --------------------------------------------------------------------------- ai
# Absent means the coach is unavailable and says so, rather than failing obscurely.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------- limits
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- storage
# Where progress photos live. `none` is the default and it is a real state, not a
# misconfiguration: with no bucket the photo endpoints answer 503 and say so, which is
# the honest outcome for a deployment that has not decided where the most sensitive data
# in the system is going to be kept.
#
# Locally this is the MinIO in docker-compose. In production it is Azure Blob Storage
# through its S3-compatible endpoint — the same adapter either way, so the path that
# handles these images is the one that gets exercised every day.
#
# THE CONTAINER MUST BE PRIVATE. Nothing here is ever served from a public URL; the API
# issues a signed URL that expires in minutes.
STORAGE_BACKEND=none
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=coresync-progress-photos
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# How long an upload credential lives — long enough for 15 MB on a poor connection,
# short enough that a leaked URL is worthless by the time anyone reads it.
UPLOAD_URL_TTL_SECONDS=900
# Read URLs are shorter still. A progress photo must never have a URL that outlives the
# session that asked for it.
READ_URL_TTL_SECONDS=300
