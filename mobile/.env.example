# Base URL of the CoreSync API. No trailing slash.
#
# `localhost` only works in a simulator. On a physical device, localhost is the device —
# use this machine's LAN address (`ipconfig` / `ifconfig`) and start the API with
# `--host 0.0.0.0`, or nothing will connect. See DEVICE-VALIDATION.md.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Stamped into the X-Client-Version header so the backend can identify old builds.
EXPO_PUBLIC_APP_VERSION=dev

# The EAS project id, required by Expo to mint a push token.
#
# WITHOUT THIS, PUSH CANNOT WORK ON A REAL DEVICE. `getExpoPushTokenAsync` needs a
# project id since SDK 49; the app degrades gracefully (it logs a warning and registers
# nothing) rather than crashing, but no notification will ever arrive.
#
# Get one by running `eas init` in this directory with an Expo account. That writes
# `expo.extra.eas.projectId` into app.json, which is read automatically in a built app —
# this variable is the escape hatch for a bare dev client.
EXPO_PUBLIC_PROJECT_ID=
