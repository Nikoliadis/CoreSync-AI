# Base URL of the CoreSync API. No trailing slash.
#
# `localhost` only works in a simulator. On a physical device, localhost is the device —
# use this machine's LAN address (`ipconfig` / `ifconfig`) and start the API with
# `--host 0.0.0.0`, or nothing will connect. See DEVICE-VALIDATION.md.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Stamped into the X-Client-Version header so the backend can identify old builds.
EXPO_PUBLIC_APP_VERSION=dev
