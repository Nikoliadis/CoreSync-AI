{
  "expo": {
    "name": "CoreSync",
    "slug": "coresync",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "coresync",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.coresync.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes to log packaged foods.",
        "NSPhotoLibraryUsageDescription": "Attach progress photos to your history.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "ai.coresync.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0b"
      },
      "permissions": [
        "CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0b",
          "dark": {
            "backgroundColor": "#0a0a0b"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c8ff3d",
          "defaultChannel": "workout_reminder"
        }
      ],
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
