# Copy to .env and fill in. Never commit .env.
# In Azure these values come from Key Vault references on the App Service configuration.

# ---------------------------------------------------------------- application
ENVIRONMENT=development                 # development | staging | production
DEBUG=true
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=gympulse
LOG_LEVEL=INFO
LOG_FORMAT=console                      # console | json  (json in deployed environments)

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+asyncpg://gympulse:gympulse@localhost:5432/gympulse
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Optional read-replica DSN; when set, read-only endpoints are routed here.
DATABASE_REPLICA_URL=

# ---------------------------------------------------------------- cache & queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-32-bytes-hex
JWT_ALGORITHM=HS256                     # switch to RS256 + JWKS once >1 service verifies tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                      # contents of the .p8, newlines escaped as \n

# ---------------------------------------------------------------- storage
STORAGE_BACKEND=s3compat                # s3compat (local MinIO) | azure_blob
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_MEDIA=media
AZURE_BLOB_CONTAINER_PROGRESS_PHOTOS=progress-photos
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=gympulse
S3_SECRET_KEY=gympulse123
SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------- AI
AI_PROVIDER=azure_openai                # azure_openai | openai | anthropic
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_CHAT_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-small
OPENAI_API_KEY=
AI_DAILY_TOKEN_BUDGET_FREE=40000
AI_DAILY_TOKEN_BUDGET_PRO=400000
AI_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- email & push
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="GymPulse <no-reply@gympulse.app>"
EXPO_ACCESS_TOKEN=                      # Expo push notification service

# ---------------------------------------------------------------- third-party data
OPENFOODFACTS_USER_AGENT=GymPulse/1.0 (contact@gympulse.app)
USDA_FDC_API_KEY=

# ---------------------------------------------------------------- observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- limits
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120
RATE_LIMIT_AI_CHAT_PER_HOUR=60
MAX_UPLOAD_SIZE_MB=15
CORS_ALLOWED_ORIGINS=http://localhost:3000
