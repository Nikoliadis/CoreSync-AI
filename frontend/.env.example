# Base URL of the CoreSync API. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Social sign-in (optional) ------------------------------------------------
# Both are PUBLIC identifiers, not secrets — a Google client ID is visible in every
# page that uses it. What protects the account is the authorised-origins list
# configured on the provider's side. Leave blank and the buttons are not rendered
# at all, which is the correct state for a deployment without credentials.
#
# Google:  console.cloud.google.com -> Credentials -> OAuth client ID -> Web application
#          Authorised JavaScript origins must include this app's origin.
# Apple:   developer.apple.com -> Identifiers -> Services ID
#          Return URLs must include <origin>/login exactly.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_SERVICE_ID=
